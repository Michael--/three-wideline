{
   "name": "three-wideline",
   "version": "0.7.0",
   "description": "A Three.js library for rendering wide lines with customizable attributes in React Three Fiber",
   "homepage": "https://github.com/Michael--/three-wideline",
   "bugs": {
      "url": "https://github.com/Michael--/three-wideline/issues"
   },
   "keywords": [
      "line",
      "width",
      "three",
      "threejs",
      "join",
      "caps",
      "custom",
      "react",
      "react-three-fiber"
   ],
   "author": "Michael Rieck (Michael--) <mr@number10.de>",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/Michael--/three-wideline.git"
   },
   "publishConfig": {
      "registry": "https://registry.npmjs.org"
   },
   "license": "MIT",
   "private": false,
   "packageManager": "pnpm@9.0.0",
   "engines": {
      "node": ">=18"
   },
   "main": "dist/index.js",
   "types": "dist/index.d.ts",
   "files": [
      "dist/**/*",
      "README.md",
      "LICENSE"
   ],
   "scripts": {
      "clean": "rimraf dist build && shx rm -rf *.tsbuildinfo",
      "debug-sample1": "vite --config src/sample1/vite.config.mjs",
      "build-sample1": "vite build --config src/sample1/vite.config.mjs --base=./",
      "start": "npm run debug-sample1",
      "build": "npm run build-sample1",
      "dist": "rollup --config rollup.config.mjs",
      "docs:api": "typedoc --options typedoc.json",
      "docs:dev": "vitepress dev docs",
      "docs:build": "pnpm docs:api && vitepress build docs",
      "docs:preview": "vitepress preview docs",
      "prepack": "npm run lint && npm run dist",
      "lint": "eslint .",
      "typecheck": "tsc --noEmit",
      "format": "prettier --write .",
      "format:check": "prettier --check .",
      "spellcheck": "cspell .",
      "test": "vitest run",
      "test:coverage": "vitest run --coverage",
      "ci": "node ci.js",
      "module-update-info": "ncu --interactive --format group",
      "prepare": "husky"
   },
   "lint-staged": {
      "*.{ts,tsx,js,jsx}": [
         "eslint",
         "prettier --write"
      ],
      "*.{md,json}": "prettier --write",
      "**/*": "cspell"
   },
   "browserslist": {
      "production": [
         ">0.2%",
         "not dead",
         "not op_mini all"
      ],
      "development": [
         "last 1 chrome version",
         "last 1 firefox version",
         "last 1 safari version"
      ]
   },
   "devDependencies": {
      "@commitlint/cli": "^20.3.1",
      "@commitlint/config-conventional": "^20.3.1",
      "@eslint/js": "^9.39.2",
      "@react-three/drei": "^10.7.7",
      "@react-three/fiber": "^9.5.0",
      "@rollup/plugin-commonjs": "^29.0.0",
      "@rollup/plugin-terser": "^0.4.4",
      "@rollup/plugin-typescript": "^12.3.0",
      "@testing-library/react": "^16.3.2",
      "@types/node": "^25.0.10",
      "@types/react": "^19.2.10",
      "@types/react-color": "^3.0.13",
      "@types/react-dom": "^19.2.3",
      "@types/react-select": "^5.0.1",
      "@types/three": "^0.182.0",
      "@typescript-eslint/eslint-plugin": "^8.54.0",
      "@typescript-eslint/parser": "^8.54.0",
      "@vitejs/plugin-react": "^5.1.2",
      "@vitejs/plugin-react-refresh": "^1.3.6",
      "@vitest/coverage-v8": "4.0.18",
      "copyfiles": "^2.4.1",
      "cspell": "^9.6.2",
      "eslint": "^9.39.2",
      "eslint-config-prettier": "^10.1.8",
      "eslint-config-react-app": "^7.0.1",
      "eslint-plugin-prettier": "^5.5.5",
      "eslint-plugin-react": "^7.37.5",
      "globals": "^17.2.0",
      "grommet": "^2.52.0",
      "grommet-icons": "^4.14.0",
      "husky": "^9.1.7",
      "jsdom": "^27.4.0",
      "lint-staged": "^16.2.7",
      "mermaid": "^11.12.2",
      "polished": "^4.3.1",
      "prettier": "^3.8.1",
      "react": "^19.2.4",
      "react-color": "^2.19.3",
      "react-dom": "^19.2.4",
      "rollup": "^4.57.0",
      "rollup-plugin-dts": "^6.3.0",
      "rollup-plugin-peer-deps-external": "^2.2.4",
      "rollup-plugin-string": "^3.0.0",
      "rollup-plugin-visualizer": "^6.0.5",
      "styled-components": "^6.3.8",
      "three": "^0.182.0",
      "typedoc": "^0.28.0",
      "typedoc-plugin-markdown": "^4.9.0",
      "typescript": "^5.9.3",
      "vite": "^5.4.0",
      "vite-raw-plugin": "^1.0.2",
      "vitepress": "^1.6.4",
      "vitepress-plugin-mermaid": "^2.0.17",
      "vitest": "^4.0.18",
      "wouter": "^3.9.0"
   },
   "peerDependencies": {
      "@react-three/fiber": ">=8.0",
      "react": ">=18.0",
      "react-dom": ">=18.0.0",
      "three": ">=0.147"
   },
   "dependencies": {
      "rimraf": "^6.1.2",
      "shx": "^0.4.0"
   }
}
